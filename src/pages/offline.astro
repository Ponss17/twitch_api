---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Sin Conexión | LosPerris" footer>
    <div class="flex min-h-full flex-1 items-center justify-center bg-[#09090b] p-5 text-center text-[#fafafa]">
        <div class="max-w-md">
            <svg
                width="64"
                height="64"
                viewBox="0 0 24 24"
                fill="none"
                stroke="#9146ff"
                stroke-width="2"
                class="mx-auto mb-4"
            >
                <path
                    d="M1 1l22 22M16.72 11.06A10.94 10.94 0 0 1 19 12.55M5 12.55a10.94 10.94 0 0 1 5.17-2.39M10.71 5.05A16 16 0 0 1 22.58 9M1.42 9a15.91 15.91 0 0 1 4.7-2.88M8.53 16.11a6 6 0 0 1 6.95 0M12 20h.01"
                ></path>
            </svg>
            <h1 class="text-2xl font-bold text-[#9146ff]">Sin conexión a internet</h1>
            <p class="mt-3 text-[#a1a1aa]">
                Parece que has perdido la conexión. Revisa tu red y vuelve a intentarlo.
            </p>
            <button
                type="button"
                onclick="location.reload()"
                class="mt-6 rounded-lg bg-[#9146ff] px-6 py-3 font-bold text-white hover:bg-[#7c3aed]"
            >
                Reintentar
            </button>
        </div>
    </div>
</BaseLayout>
