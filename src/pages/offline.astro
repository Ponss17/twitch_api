---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout page="Sin Conexión" footer brandTheme>
    <div class="flex min-h-full flex-1 items-center justify-center bg-bg-main p-5 text-center text-text-main">
        <div class="max-w-md">
            <svg
                width="64"
                height="64"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                class="mx-auto mb-4 text-primary"
            >
                <path
                    d="M1 1l22 22M16.72 11.06A10.94 10.94 0 0 1 19 12.55M5 12.55a10.94 10.94 0 0 1 5.17-2.39M10.71 5.05A16 16 0 0 1 22.58 9M1.42 9a15.91 15.91 0 0 1 4.7-2.88M8.53 16.11a6 6 0 0 1 6.95 0M12 20h.01"
                ></path>
            </svg>
            <h1 class="text-2xl font-bold text-primary">Sin conexión a internet</h1>
            <p class="mt-3 text-text-muted">
                Parece que has perdido la conexión. Revisa tu red y vuelve a intentarlo.
            </p>
            <button
                type="button"
                onclick="location.reload()"
                class="mt-6 rounded-lg bg-primary px-6 py-3 font-bold text-white hover:bg-primary-hover"
            >
                Reintentar
            </button>
        </div>
    </div>
</BaseLayout>
