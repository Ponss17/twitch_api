---
import '../styles/global.css';
import { docsPage } from '@/core/utils/docsTw';
import { pageTitle } from '@/core/config/pageTitle';
import { getThemeInitScript } from '@/core/theme';

export interface Props {
    /** Nombre de la página; se formatea como «Página | LosPerris». */
    page?: string;
    /** Título completo del documento (anula `page` si se pasa). */
    title?: string;
    description?: string;
    canonical?: string;
    ogTitle?: string;
    ogDescription?: string;
    footer?: boolean;
}

const {
    page,
    title,
    description = 'Documentación oficial de LosPerris Twitch API. Guía técnica de uso, comandos y herramientas para streamers.',
    canonical,
    ogTitle,
    ogDescription,
    footer = true
} = Astro.props;

import { Footer } from '@/shared/layout/Footer';
import { staticPath, absoluteAssetUrl } from '@/core/config/paths';
import SpeedInsights from '@vercel/speed-insights/astro';
import Analytics from '@vercel/analytics/astro';

const documentTitle = title ?? (page ? pageTitle(page) : pageTitle('Documentación'));

const canonicalUrl = canonical ?? `${Astro.url.origin}${staticPath('/docs')}`;
const siteOrigin = canonical ? new URL(canonical).origin : new URL(canonicalUrl).origin;
const shareTitle = ogTitle ?? documentTitle;
const shareDesc = ogDescription ?? description;
const shareImage = absoluteAssetUrl('/img/logo.svg', siteOrigin);
const isDev = import.meta.env.DEV;
const swUrl = staticPath('/sw.js');
const swScope = staticPath('/');
---

<!doctype html>
<html lang="es">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="theme-color" content="#9146ff" />
        {/* Evitar Flash of Unstyled Content (FOUC) síncronamente */}
        <script is:inline set:html={getThemeInitScript()} />
        <meta name="description" content={description} />
        <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
        <link rel="canonical" href={canonicalUrl} />
        <meta property="og:type" content="website" />
        <meta property="og:url" content={canonicalUrl} />
        <meta property="og:title" content={shareTitle} />
        <meta property="og:description" content={shareDesc} />
        <meta property="og:image" content={shareImage} />
        <meta property="twitter:card" content="summary" />
        <meta property="twitter:url" content={canonicalUrl} />
        <meta property="twitter:title" content={shareTitle} />
        <meta property="twitter:description" content={shareDesc} />
        <meta property="twitter:image" content={shareImage} />
        <link rel="icon" type="image/svg+xml" href={staticPath('/img/logo.svg')} />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            rel="stylesheet"
            href="https://fonts.googleapis.com/css2?family=Geist+Mono:wght@100..900&family=Geist:wght@100..900&family=Inter:wght@300..800&family=Plus+Jakarta+Sans:wght@400..800&family=Rubik:wght@400..900&family=Space+Grotesk:wght@400..700&display=swap"
            media="print"
            onload="this.media='all'"
        />
        <noscript>
            <link
                rel="stylesheet"
                href="https://fonts.googleapis.com/css2?family=Geist+Mono:wght@100..900&family=Geist:wght@100..900&family=Inter:wght@300..800&family=Plus+Jakarta+Sans:wght@400..800&family=Rubik:wght@400..900&family=Space+Grotesk:wght@400..700&display=swap"
            />
        </noscript>
        <title>{documentTitle}</title>
        <SpeedInsights scriptSrc="https://va.vercel-scripts.com/v1/speed-insights/script.js" />
        {isDev && (
            <script is:inline>
                (function () {
                    if (!('serviceWorker' in navigator)) return;
                    if (sessionStorage.getItem('sw-cleared') === '1') return;
                    const hadController = !!navigator.serviceWorker.controller;
                    navigator.serviceWorker.getRegistrations().then(function (regs) {
                        if (!regs.length && !hadController) return;
                        return Promise.all(regs.map(function (reg) { return reg.unregister(); }))
                            .then(function () {
                                if (!('caches' in window)) return;
                                return caches.keys().then(function (keys) {
                                    return Promise.all(keys.map(function (key) { return caches.delete(key); }));
                                });
                            })
                            .then(function () {
                                sessionStorage.setItem('sw-cleared', '1');
                                if (hadController || regs.length) location.reload();
                            });
                    });
                })();
            </script>
        )}
    </head>
    <body class:list={[docsPage, 'flex min-h-screen flex-col relative']}>
        <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-bg-secondary focus:text-primary focus:border focus:border-border-strong focus:rounded-lg focus:shadow-lg focus:outline-none focus:ring-2 focus:ring-primary/50 transition-colors">
            Saltar al contenido principal
        </a>
        <main id="main-content" class="relative z-10 flex min-h-0 flex-1 flex-col bg-transparent">
            <slot />
        </main>
        {footer && <Footer client:visible isDashboard />}
        {!isDev && (
            <script
                is:inline
                src={staticPath('/js/sw-register.js')}
                defer
                data-sw-url={swUrl}
                data-sw-scope={swScope}
            />
        )}
        <Analytics />
    </body>
</html>
