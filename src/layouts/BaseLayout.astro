---
import '../styles/global.css';
import { Footer } from '@/shared/layout/Footer';
import SpeedInsights from '@vercel/speed-insights/astro';
import Analytics from '@vercel/analytics/astro';
import { staticPath, absoluteAssetUrl } from '@/core/config/paths';
import { pageTitle } from '@/core/config/pageTitle';

const FONTS_BRAND =
    'https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=Geist+Mono:wght@400;500&display=swap';
const FONTS_APP =
    'https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=Geist+Mono:wght@400;500&family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Rubik:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap';

export interface Props {
    /** Nombre de la página; se formatea como «Página | LosPerris». */
    page?: string;
    /** Título completo del documento (anula `page` si se pasa). */
    title?: string;
    description?: string;
    canonical?: string;
    keywords?: string;
    ogTitle?: string;
    ogDescription?: string;
    ogImage?: string;
    ogUrl?: string;
    robots?: string;
    noindex?: boolean;
    /** Muestra el footer global al final de la página. */
    footer?: boolean;
    /**
     * Superficie pública de marca: fuerza tema dark sin tocar la preferencia
     * guardada del panel (`los_perris_theme`).
     */
    brandTheme?: boolean;
}

const {
    page,
    title,
    description = 'Comandos y herramientas para streamers',
    canonical,
    keywords = 'Twitch API, comandos twitch, bot twitch gratis, followage, minijuegos twitch, herramientas para streamers, losperris',
    ogTitle,
    ogDescription,
    ogImage,
    ogUrl,
    robots = 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1',
    noindex = false,
    footer = false,
    brandTheme = false
} = Astro.props;

const fontsHref = brandTheme ? FONTS_BRAND : FONTS_APP;
const themeInitScriptPath = staticPath(
    brandTheme ? '/js/brand-theme-init.js' : '/js/theme-init.js'
);

const documentTitle = title ?? (page ? pageTitle(page) : pageTitle('Inicio'));

const siteOrigin = canonical ? new URL(canonical).origin : Astro.url.origin;
/** trailingSlash: 'always' — el canonical debe terminar en / (salvo archivos). */
const rawCanonical = canonical ?? Astro.url.href;
const canonicalParsed = new URL(rawCanonical);
if (!canonicalParsed.pathname.endsWith('/') && !/\.[a-z0-9]+$/i.test(canonicalParsed.pathname)) {
    canonicalParsed.pathname = `${canonicalParsed.pathname}/`;
}
const canonicalUrl = canonicalParsed.href;
const shareTitle = ogTitle ?? documentTitle;
const shareDesc = ogDescription ?? description;
const shareImage = ogImage ?? absoluteAssetUrl('/img/og-banner.png', siteOrigin);
const shareUrl = ogUrl ?? canonicalUrl;
const robotsContent = noindex ? 'noindex, nofollow' : robots;
const isDev = import.meta.env.DEV;
const swUrl = staticPath('/sw.js');
const swScope = staticPath('/');
---

<!doctype html>
<html lang="es">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="description" content={description} />
        <meta name="keywords" content={keywords} />
        <meta name="author" content="LosPerris" />
        <meta name="robots" content={robotsContent} />
        <link rel="canonical" href={canonicalUrl} />
        <meta name="theme-color" content="#9146ff" />
        
        {/* Evitar Flash of Unstyled Content (FOUC) síncronamente */}
        <script is:inline src={themeInitScriptPath}></script>
        
        <!-- Open Graph -->
        <meta property="og:site_name" content="LosPerris" />
        <meta property="og:locale" content="es_ES" />
        <meta property="og:type" content="website" />
        <meta property="og:url" content={shareUrl} />
        <meta property="og:title" content={shareTitle} />
        <meta property="og:description" content={shareDesc} />
        <meta property="og:image" content={shareImage} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content={shareTitle} />
        
        <!-- Twitter Card -->
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:site" content="@losperris" />
        <meta name="twitter:url" content={shareUrl} />
        <meta name="twitter:title" content={shareTitle} />
        <meta name="twitter:description" content={shareDesc} />
        <meta name="twitter:image" content={shareImage} />
        
        <link rel="icon" type="image/svg+xml" href={staticPath('/img/logo.svg')} />
        <link rel="apple-touch-icon" sizes="180x180" href={staticPath('/apple-touch-icon.png')} />
        <link rel="manifest" href={staticPath('/manifest.json')} />

        <!-- Structured Data -->
        <script is:inline type="application/ld+json" set:html={JSON.stringify({
            "@context": "https://schema.org",
            "@type": "WebPage",
            "name": documentTitle,
            "description": description,
            "url": canonicalUrl
        })}></script>
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link rel="stylesheet" href={fontsHref} />
        <title>{documentTitle}</title>
        <script is:inline src={staticPath('/js/speed-insights-redaction.js')}></script>
        <SpeedInsights scriptSrc="https://va.vercel-scripts.com/v1/speed-insights/script.js" />
        {isDev && (
            <script is:inline>
                (function () {
                    if (!('serviceWorker' in navigator)) return;
                    if (sessionStorage.getItem('sw-cleared') === '1') return;
                    const hadController = !!navigator.serviceWorker.controller;
                    navigator.serviceWorker.getRegistrations().then(function (regs) {
                        if (!regs.length && !hadController) return;
                        return Promise.all(
                            regs.map(function (reg) {
                                return reg.unregister();
                            })
                        )
                            .then(function () {
                                if (!('caches' in window)) return;
                                return caches.keys().then(function (keys) {
                                    return Promise.all(
                                        keys.map(function (key) {
                                            return caches.delete(key);
                                        })
                                    );
                                });
                            })
                            .then(function () {
                                sessionStorage.setItem('sw-cleared', '1');
                                if (hadController || regs.length) location.reload();
                            });
                    });
                })();
            </script>
        )}
        <slot name="head" />
    </head>
    <body class="flex min-h-screen flex-col bg-bg-main text-text-main antialiased relative">
        <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-bg-secondary focus:text-primary focus:border focus:border-border-strong focus:rounded-lg focus:shadow-lg focus:outline-none focus:ring-2 focus:ring-primary/50 transition-colors">
            Saltar al contenido principal
        </a>
        <main id="main-content" class="relative z-10 flex min-h-0 flex-1 flex-col bg-transparent">
            <slot />
        </main>
        {footer && <Footer client:visible isDashboard={Astro.url.pathname.includes('/dashboard')} />}
        {!isDev && (
            <script
                is:inline
                src={staticPath('/js/sw-register.js')}
                defer
                data-sw-url={swUrl}
                data-sw-scope={swScope}
            />
        )}
        <Analytics />
    </body>
</html>
