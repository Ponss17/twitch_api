---
import { Badge } from '@astrojs/starlight/components';
---

<div class="dashboard-tool-header">
	<Badge text="Solo dashboard" variant="note" size="large" />
</div>

<a href="/docs/panel/" class="auth-notice auth-notice--dashboard">
	<span class="auth-notice__label">Autenticación</span>
	<span class="auth-notice__text">
		Requiere <strong>sesión OAuth</strong> del panel (cookie + token Twitch). No uses la API Key de bot en el navegador del overlay.
	</span>
	<span class="auth-notice__arrow" aria-hidden="true">›</span>
</a>
