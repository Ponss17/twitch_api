---
import { readFileSync } from 'node:fs';
import path from 'node:path';

const { siteTitleHref } = Astro.locals.starlightRoute;

const logoSvg = readFileSync(path.join(process.cwd(), 'public/img/logo.svg'), 'utf-8')
	.replace(/<\?xml[\s\S]*?\?>/, '')
	.replace(/<!DOCTYPE[\s\S]*?>/, '')
	.replace('<svg ', '<svg class="site-title-logo-svg" ');
---

<a href={siteTitleHref} class="site-title sl-flex">
	<span class="site-title-logo" transition:persist="site-logo" aria-hidden="true" set:html={logoSvg} />
	<span translate="no"><span class="site-title-brand">LosPerris</span> <span class="site-title-accent">API</span></span>
</a>

<style>
	@layer starlight.core {
		.site-title {
			align-items: center;
			gap: 0.625rem;
			font-size: var(--sl-text-h4);
			font-weight: 600;
			color: var(--sl-color-white);
			text-decoration: none;
			white-space: nowrap;
			min-width: 0;
			line-height: 1;
		}
		.site-title-logo {
			display: flex;
			flex-shrink: 0;
			height: 1.75rem;
			width: 1.75rem;
			align-items: center;
			justify-content: center;
			overflow: hidden;
		}
		.site-title-logo :global(.site-title-logo-svg) {
			height: 100%;
			width: auto;
			max-width: 100%;
			object-fit: contain;
			object-position: 0 50%;
			display: block;
		}
		.site-title-accent {
			color: #9146ff;
		}
	}
</style>
