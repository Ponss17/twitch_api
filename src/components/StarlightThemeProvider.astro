---
/**
 * Tema fijo de marca (oscuro) para docs.
 * No lee prefers-color-scheme ni localStorage de Starlight.
 */
---

<script>
	(window as unknown as {
		StarlightThemeProvider: { updatePickers: () => void };
	}).StarlightThemeProvider = (() => {
		document.documentElement.dataset.theme = 'dark';
		return {
			updatePickers() {}
		};
	})();
</script>
