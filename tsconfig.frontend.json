{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "rootDir": "./frontend",
    "outDir": "./public/js",
    "moduleResolution": "Node",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "allowJs": true,
    "noEmitOnError": false,
    "lib": [
      "DOM",
      "ES2020"
    ]
  },
  "include": [
    "frontend/**/*"
  ],
  "exclude": [
    "frontend/vendor"
  ]
}