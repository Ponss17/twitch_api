{
    "name": "twitch_api",
    "version": "5.0.0",
    "description": "LosPerris Twitch API — Astro + React + Tailwind frontend, Express backend (API compatible)",
    "private": true,
    "engines": {
        "node": ">=22.12.0"
    },
    "packageManager": "pnpm@11.13.0",
    "scripts": {
        "dev": "run-p dev:api dev:web",
        "dev:web": "astro dev",
        "dev:web:e2e": "astro dev --host 127.0.0.1 --port 4321",
        "dev:clean": "node scripts/clean-vite-cache.js",
        "dev:fresh": "pnpm dev:clean && pnpm dev",
        "dev:api": "node scripts/check-env.js && tsx watch -r dotenv/config backend/src/serverless.ts",
        "dev:api:e2e": "tsx -r dotenv/config backend/src/serverless.ts",
        "dev:e2e": "run-p -r dev:api:e2e dev:web:e2e",
        "start:e2e": "run-p -r -l dev:api:e2e dev:web:e2e",
        "check-env": "node scripts/check-env.js",
        "build": "tsc -p tsconfig.backend.json && node scripts/prepare-api-entry.js && node scripts/astro-build.mjs",
        "build:web": "node scripts/astro-build.mjs",
        "build:api": "tsc -p tsconfig.backend.json && node scripts/prepare-api-entry.js",
        "start": "node -r dotenv/config api/_bundle/serverless.js",
        "preview": "astro preview",
        "type-check": "astro check --tsconfig tsconfig.astro.json && tsc -p tsconfig.backend.json --noEmit",
        "lint": "eslint .",
        "test": "jest --config jest.config.js",
        "audit:prod": "pnpm audit --audit-level=high",
        "prepare": "husky",
        "smoke": "node scripts/print-smoke.js",
        "test:watch": "jest --config jest.config.js --watch",
        "test:coverage": "jest --config jest.config.js --coverage",
        "test:e2e": "playwright test",
        "test:e2e:ui": "playwright test --ui"
    },
    "dependencies": {
        "@supabase/supabase-js": "^2.110.8",
        "@upstash/redis": "^1.38.0",
        "@vercel/functions": "^3.7.5",
        "axios": "^1.18.1",
        "axios-retry": "^4.5.0",
        "compression": "^1.8.1",
        "cors": "^2.8.6",
        "dotenv": "^17.4.2",
        "express": "^5.2.1",
        "groq-sdk": "^0.37.0",
        "helmet": "^8.3.0",
        "jsonwebtoken": "^9.0.3",
        "winston": "^3.19.0",
        "winston-transport": "^4.9.0",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@astrojs/check": "^0.9.9",
        "@astrojs/react": "^6.0.1",
        "@astrojs/starlight": "^0.41.3",
        "@dnd-kit/core": "^6.3.1",
        "@dnd-kit/sortable": "^10.0.0",
        "@dnd-kit/utilities": "^3.2.2",
        "@eslint/js": "^9.39.5",
        "@playwright/test": "^1.61.1",
        "@tailwindcss/vite": "^4.3.3",
        "@testing-library/jest-dom": "^6.10.0",
        "@testing-library/react": "^16.3.2",
        "@types/canvas-confetti": "^1.9.0",
        "@types/compression": "^1.8.1",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/jest": "^30.0.0",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node": "^25.9.5",
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.3",
        "@types/supertest": "^7.2.1",
        "@vercel/analytics": "^2.0.1",
        "@vercel/speed-insights": "^2.0.0",
        "astro": "^7.1.3",
        "canvas-confetti": "^1.9.4",
        "eslint": "^9.39.5",
        "eslint-plugin-astro": "^1.7.0",
        "eslint-plugin-react-hooks": "^5.2.0",
        "framer-motion": "^12.42.2",
        "globals": "^16.5.0",
        "husky": "^9.1.7",
        "jest": "^30.4.2",
        "jest-environment-jsdom": "^30.4.1",
        "lenis": "^1.3.25",
        "lucide-react": "^1.25.0",
        "npm-run-all2": "^9.0.2",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "recharts": "^3.10.0",
        "shell-quote": "^1.10.0",
        "sonner": "^2.0.7",
        "supertest": "^7.2.2",
        "tailwindcss": "^4.3.3",
        "tmi.js": "^1.8.5",
        "ts-jest": "^29.4.11",
        "tsx": "^4.23.1",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.65.0"
    },
    "overrides": {
        "js-yaml": "^4.3.1",
        "postcss": "^8.5.23"
    },
    "resolutions": {
        "js-yaml": "^4.3.1",
        "postcss": "^8.5.23"
    }
}