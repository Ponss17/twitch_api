{
    "name": "twitch_api",
    "version": "5.0.0",
    "description": "LosPerris Twitch API — Astro + React + Tailwind frontend, Express backend (API compatible)",
    "private": true,
    "engines": {
        "node": ">=22.12.0"
    },
    "packageManager": "pnpm@9.15.9",
    "scripts": {
        "dev": "concurrently \"pnpm dev:api\" \"pnpm dev:web\"",
        "dev:web": "astro dev",
        "dev:web:e2e": "astro dev --host 127.0.0.1 --port 4321",
        "dev:clean": "node scripts/clean-vite-cache.js",
        "dev:fresh": "pnpm dev:clean && pnpm dev",
        "dev:api": "node scripts/check-env.js && tsx watch -r dotenv/config backend/src/serverless.ts",
        "dev:api:e2e": "tsx -r dotenv/config backend/src/serverless.ts",
        "dev:e2e": "concurrently -k \"pnpm dev:api:e2e\" \"pnpm dev:web:e2e\"",
        "start:e2e": "concurrently -k -n api,web \"pnpm dev:api:e2e\" \"pnpm dev:web:e2e\"",
        "check-env": "node scripts/check-env.js",
        "build": "tsc -p tsconfig.backend.json && node scripts/prepare-api-entry.js && astro build",
        "build:web": "astro build",
        "build:api": "tsc -p tsconfig.backend.json && node scripts/prepare-api-entry.js",
        "start": "node -r dotenv/config api/_bundle/serverless.js",
        "preview": "astro preview",
        "type-check": "astro check --tsconfig tsconfig.astro.json && tsc -p tsconfig.backend.json --noEmit",
        "lint": "eslint .",
        "test": "jest --config jest.config.js",
        "audit:prod": "pnpm audit --audit-level=high",
        "prepare": "husky",
        "smoke": "node scripts/print-smoke.js",
        "test:watch": "jest --config jest.config.js --watch",
        "test:coverage": "jest --config jest.config.js --coverage",
        "test:e2e": "playwright test",
        "test:e2e:ui": "playwright test --ui"
    },
    "dependencies": {
        "@astrojs/react": "^5.0.7",
        "@dnd-kit/core": "^6.3.1",
        "@dnd-kit/sortable": "^10.0.0",
        "@dnd-kit/utilities": "^3.2.2",
        "@supabase/supabase-js": "^2.107.0",
        "@tailwindcss/vite": "^4.3.0",
        "@types/compression": "^1.8.1",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node": "^25.1.0",
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.3",
        "@vercel/kv": "^3.0.0",
        "@vercel/speed-insights": "^2.0.0",
        "astro": "^6.4.4",
        "axios": "^1.15.2",
        "axios-retry": "^4.5.0",
        "canvas-confetti": "^1.9.4",
        "compression": "^1.8.1",
        "cors": "^2.8.5",
        "dotenv": "^17.2.3",
        "express": "^5.2.1",
        "groq-sdk": "^0.37.0",
        "helmet": "^8.1.0",
        "jsonwebtoken": "^9.0.3",
        "lenis": "^1.3.19",
        "lucide-react": "^1.21.0",
        "react": "^19.2.7",
        "react-dom": "^19.2.7",
        "recharts": "^3.9.2",
        "slot-text": "^0.3.1",
        "sonner": "^2.0.7",
        "tailwindcss": "^4.3.0",
        "tmi.js": "^1.8.5",
        "winston": "^3.19.0",
        "winston-transport": "^4.9.0",
        "zod": "^4.3.5"
    },
    "devDependencies": {
        "@astrojs/check": "^0.9.9",
        "@eslint/js": "^9.39.4",
        "@playwright/test": "^1.61.0",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.2",
        "@types/canvas-confetti": "^1.9.0",
        "@types/jest": "^30.0.0",
        "@types/supertest": "^7.2.0",
        "concurrently": "^9.2.1",
        "eslint": "^9.39.4",
        "eslint-plugin-astro": "^1.7.0",
        "eslint-plugin-react-hooks": "^5.2.0",
        "globals": "^16.5.0",
        "husky": "^9.1.7",
        "jest": "^30.2.0",
        "jest-environment-jsdom": "^30.4.1",
        "supertest": "^7.2.2",
        "ts-jest": "^29.4.6",
        "tsx": "^4.21.0",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.61.1"
    },
    "pnpm": {
        "overrides": {
            "yaml": "2.9.0",
            "js-yaml@3": "3.15.0",
            "esbuild": "0.28.1"
        },
        "onlyBuiltDependencies": [
            "esbuild",
            "sharp",
            "unrs-resolver"
        ]
    }
}
