{
    "name": "twitch_api",
    "version": "4.0.0",
    "description": "Project initialized.",
    "main": "api/index.ts",
    "scripts": {
        "build:frontend": "node scripts/build-frontend.js",
        "watch:frontend": "tsc -p tsconfig.frontend.json --watch",
        "build": "shx rm -rf dist && pnpm run build:frontend && tsc",
        "postbuild": "shx cp -r public dist/",
        "start": "node -r dotenv/config dist/api/index.js",
        "dev": "ts-node --files -r dotenv/config api/index.ts",
        "check-env": "node scripts/check-env.js",
        "lint": "eslint .",
        "format": "prettier --write .",
        "type-check": "tsc --noEmit",
        "validate": "npm run lint && npm run type-check && npm run build",
        "clean": "shx rm -rf dist",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:coverage": "jest --coverage",
        "deploy": "npm run build && vercel --prod",
        "prepare": "husky"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Ponss17/twitch_api.git"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "bugs": {
        "url": "https://github.com/Ponss17/twitch_api/issues"
    },
    "homepage": "https://github.com/Ponss17/twitch_api#readme",
    "dependencies": {
        "@sentry/node": "^10.51.0",
        "@supabase/supabase-js": "^2.100.0",
        "@vercel/kv": "^3.0.0",
        "@vercel/speed-insights": "^2.0.0",
        "axios": "^1.15.2",
        "axios-retry": "^4.5.0",
        "compression": "^1.8.1",
        "cors": "^2.8.5",
        "dotenv": "^17.2.3",
        "express": "^5.2.1",
        "groq-sdk": "^0.37.0",
        "helmet": "^8.1.0",
        "jsonwebtoken": "^9.0.3",
        "lenis": "^1.3.19",
        "winston": "^3.19.0",
        "winston-transport": "^4.9.0",
        "zod": "^4.3.5"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.2",
        "@types/compression": "^1.8.1",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/helmet": "^0.0.48",
        "@types/jest": "^30.0.0",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node": "^25.1.0",
        "@types/supertest": "^7.2.0",
        "@types/winston": "^2.4.4",
        "esbuild": "^0.27.3",
        "eslint": "^9.39.2",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.5",
        "globals": "^17.2.0",
        "husky": "^9.1.7",
        "jest": "^30.2.0",
        "lint-staged": "^16.2.7",
        "prettier": "^3.8.1",
        "shx": "^0.4.0",
        "supertest": "^7.2.2",
        "ts-jest": "^29.4.6",
        "ts-node": "^10.9.2",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.54.0"
    },
    "lint-staged": {
        "*.{ts,js,json,md}": [
            "prettier --write"
        ],
        "*.ts": [
            "eslint --fix"
        ]
    },
    "pnpm": {
        "overrides": {
            "follow-redirects": ">=1.16.0"
        }
    }
}
