{
    "extends": "./node_modules/astro/tsconfigs/strict.json",
    "compilerOptions": {
        "paths": {
            "@/*": ["./src/*"],
            "@contracts/*": ["./backend/src/core/schemas/*"],
            "@starlight/*": ["./node_modules/@astrojs/starlight/*"]
        },
        "verbatimModuleSyntax": false
    },
    "include": [
        ".astro/types.d.ts",
        "src/**/*",
        "astro.config.mjs",
        "backend/src/core/schemas/**/*.ts"
    ],
    "exclude": ["node_modules", "dist", "./api", "tests"]
}
