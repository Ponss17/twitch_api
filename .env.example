# LosPerris Twitch API — plantilla de variables de entorno
# cp .env.example .env && pnpm check-env

# --- Twitch OAuth (obligatorio) ---
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
ENCRYPTION_KEY=
# Secreto HMAC para OAuth state / auth exchange / overlay (obligatorio en producción, ≥32 chars).
# Generar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
HMAC_SIGNING_SECRET=
# Callback registrado en Twitch Developer Console:
TWITCH_REDIRECT_URI=https://ttv.losperris.dev/api/auth/twitch/callback

# --- URLs del proyecto ---
# Desarrollo local:
# BASE_URL=http://localhost:3000/api
# FRONTEND_URL=http://localhost:4321
# Producción (defaults si se omiten en Vercel con localhost en .env):
BASE_URL=https://ttv.losperris.dev/api
FRONTEND_URL=https://ttv.losperris.dev

# --- Supabase (obligatorio) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=

# --- Vercel KV (obligatorio en producción — rate limit global) ---
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- Opcionales ---
GROQ_API_KEY=
DISCORD_FEEDBACK_WEBHOOK_URL=
DISCORD_HEALTH_WEBHOOK_URL=
# OAuth Discord (vincular cuenta en el panel) — misma app del bot
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://ttv.losperris.dev/api/auth/discord/callback
PORT=3000
NODE_ENV=development

# Logs: en Vercel (VERCEL=1) se logean peticiones API automáticamente.
# LOG_VERBOSE=1
# LOG_LEVEL=debug
