# Copia desde twitch_api/.env — mismas variables requeridas
# cp ../twitch_api/.env .env

TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
ENCRYPTION_KEY=

# --- Desarrollo local (pnpm dev) ---
# TWITCH_REDIRECT_URI=http://localhost:3000/api/twitch/auth/twitch/callback
# BASE_URL=http://localhost:3000/api/twitch
# FRONTEND_URL=http://localhost:4321

# --- Vercel / producción (como el proyecto viejo) ---
# Obligatoria en Vercel (y en Twitch Console → OAuth Redirect URLs):
# TWITCH_REDIRECT_URI=https://www.losperris.dev/api/twitch/auth/twitch/callback
#
# Opcionales — si no las creas en Vercel, el código usa defaults:
# BASE_URL=https://www.losperris.dev/api/twitch
# FRONTEND_URL no existía en el viejo; si falta, se deduce de BASE_URL → https://www.losperris.dev

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=

KV_REST_API_URL=
KV_REST_API_TOKEN=

GROQ_API_KEY=
SENTRY_DSN=
PORT=3000

# Logs: en Vercel (VERCEL=1) se logean todas las peticiones API automáticamente.
# LOG_VERBOSE=1
# LOG_LEVEL=debug
