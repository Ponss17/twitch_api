{
    "version": 2,
    "functions": {
        "api/index.ts": {
            "maxDuration": 60,
            "memory": 256
        }
    },
    "headers": [
        {
            "source": "/(.*)",
            "headers": [
                {
                    "key": "Content-Security-Policy",
                    "value": "upgrade-insecure-requests; frame-ancestors 'self'"
                },
                {
                    "key": "X-Frame-Options",
                    "value": "SAMEORIGIN"
                },
                {
                    "key": "X-Content-Type-Options",
                    "value": "nosniff"
                },
                {
                    "key": "Referrer-Policy",
                    "value": "strict-origin-when-cross-origin"
                },
                {
                    "key": "Strict-Transport-Security",
                    "value": "max-age=63072000; includeSubDomains; preload"
                }
            ]
        }
    ],
    "rewrites": [
        {
            "source": "/docs",
            "destination": "/public/docs.html"
        },
        {
            "source": "/dashboard",
            "destination": "/public/dashboard.html"
        },
        {
            "source": "/(api/twitch|twitch|auth)/(.*)",
            "destination": "/api/index.ts"
        },
        {
            "source": "/system/(.*)",
            "destination": "/api/index.ts"
        }
    ],
    "cleanUrls": false
}