{
    "version": 2,
    "functions": {
        "api/index.ts": {
            "maxDuration": 60,
            "memory": 256
        }
    },
    "headers": [
        {
            "source": "/(img|css|js)/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=604800, immutable"
                }
            ]
        },
        {
            "source": "/api/twitch/(img|css|js)/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=604800, immutable"
                }
            ]
        },
        {
            "source": "/(.*)",
            "headers": [
                {
                    "key": "X-Frame-Options",
                    "value": "DENY"
                },
                {
                    "key": "X-Content-Type-Options",
                    "value": "nosniff"
                },
                {
                    "key": "Referrer-Policy",
                    "value": "no-referrer-when-downgrade"
                },
                {
                    "key": "Strict-Transport-Security",
                    "value": "max-age=31536000; includeSubDomains; preload"
                }
            ]
        }
    ],
    "rewrites": [
        { "source": "/api/twitch/_vercel/(.*)", "destination": "/api/twitch/_vercel/$1" },
        {
            "source": "/((?!api/twitch/_vercel|img|css|js|components|_vercel).*)",
            "destination": "/api/index.ts"
        }
    ],
    "cleanUrls": false
}
