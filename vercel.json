{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "buildCommand": "pnpm build",
    "installCommand": "pnpm install",
    "outputDirectory": "dist",
    "functions": {
        "api/index.js": {
            "includeFiles": "api/_bundle/**"
        }
    },
    "headers": [
        {
            "source": "/sw.js",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=0, must-revalidate"
                }
            ]
        },
        {
            "source": "/img/:path*",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=31536000, immutable"
                }
            ]
        },
        {
            "source": "/favicon.svg",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=31536000, immutable"
                }
            ]
        },
        {
            "source": "/manifest.json",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=86400, stale-while-revalidate=604800"
                }
            ]
        },
        {
            "source": "/_astro/:path*",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=31536000, immutable"
                }
            ]
        },
        {
            "source": "/overlay/:path*",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "no-store, must-revalidate"
                }
            ]
        },
        {
            "source": "/(.*).html",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "private, max-age=0, must-revalidate"
                }
            ]
        },
        {
            "source": "/(.*)",
            "headers": [
                {
                    "key": "Content-Security-Policy",
                    "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://va.vercel-scripts.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; worker-src blob:; connect-src 'self' https://id.twitch.tv https://api.twitch.tv https://*.twitch.tv wss://*.twitch.tv wss://irc-ws.chat.twitch.tv https://*.supabase.co wss://*.supabase.co https://va.vercel-scripts.com https://vitals.vercel-insights.com; frame-src 'self' https://id.twitch.tv https://*.twitch.tv; object-src 'none'; frame-ancestors 'none'"
                },
                {
                    "key": "Cross-Origin-Opener-Policy",
                    "value": "same-origin"
                },
                {
                    "key": "Cross-Origin-Resource-Policy",
                    "value": "same-origin"
                },
                {
                    "key": "X-Frame-Options",
                    "value": "DENY"
                },
                {
                    "key": "X-Content-Type-Options",
                    "value": "nosniff"
                },
                {
                    "key": "Referrer-Policy",
                    "value": "strict-origin-when-cross-origin"
                },
                {
                    "key": "Permissions-Policy",
                    "value": "camera=(), microphone=(), geolocation=(), fullscreen=(self \"https://clips.twitch.tv\" \"https://*.twitch.tv\"), encrypted-media=(self \"https://clips.twitch.tv\" \"https://*.twitch.tv\")"
                },
                {
                    "key": "Strict-Transport-Security",
                    "value": "max-age=31536000; includeSubDomains; preload"
                }
            ]
        }
    ],
    "redirects": [
        { "source": "/privacidad", "destination": "/legal#privacidad", "permanent": true },
        { "source": "/privacidad/", "destination": "/legal#privacidad", "permanent": true },
        { "source": "/terminos", "destination": "/legal#terminos", "permanent": true },
        { "source": "/terminos/", "destination": "/legal#terminos", "permanent": true },
        { "source": "/cookies", "destination": "/legal#cookies", "permanent": true },
        { "source": "/cookies/", "destination": "/legal#cookies", "permanent": true }
    ],
    "rewrites": [
        {
            "source": "/dashboard/:tab(home|analytics|followage|clips|shoutout|trends|stalker|magic8|roulette|russian|duel|settings|feedback)",
            "destination": "/dashboard/index.html"
        },
        {
            "source": "/404",
            "destination": "/404.html"
        },
        {
            "source": "/404/",
            "destination": "/404.html"
        },
        {
            "source": "/429",
            "destination": "/429/index.html"
        },
        {
            "source": "/429/",
            "destination": "/429/index.html"
        },
        {
            "source": "/500",
            "destination": "/500.html"
        },
        {
            "source": "/500/",
            "destination": "/500.html"
        },
        {
            "source": "/api/:path+/",
            "destination": "/api/index.js"
        },
        {
            "source": "/api/:path*",
            "destination": "/api/index.js"
        },
        {
            "source": "/auth/:path+/",
            "destination": "/api/index.js"
        },
        {
            "source": "/auth/:path*",
            "destination": "/api/index.js"
        },
        {
            "source": "/twitch/:path+/",
            "destination": "/api/index.js"
        },
        {
            "source": "/twitch/:path*",
            "destination": "/api/index.js"
        },
        {
            "source": "/health",
            "destination": "/api/index.js"
        },
        {
            "source": "/robots.txt",
            "destination": "/api/index.js"
        },
        {
            "source": "/sitemap.xml",
            "destination": "/api/index.js"
        }
    ]
}