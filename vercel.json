{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "buildCommand": "pnpm build",
    "installCommand": "pnpm install",
    "outputDirectory": "dist",
    "functions": {
        "api/index.js": {
            "includeFiles": "api/_bundle/**"
        }
    },
    "redirects": [
        { "source": "/", "destination": "/api/twitch/", "permanent": false },
        { "source": "/api/twitch", "destination": "/api/twitch/", "permanent": true }
    ],
    "headers": [
        {
            "source": "/api/twitch/sw.js",
            "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
        },
        {
            "source": "/api/twitch/img/:path*",
            "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
        },
        {
            "source": "/api/twitch/_astro/:path*",
            "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
        },
        {
            "source": "/(.*).html",
            "headers": [{ "key": "Cache-Control", "value": "private, max-age=0, must-revalidate" }]
        },
        {
            "source": "/(.*)",
            "headers": [
                { "key": "X-Frame-Options", "value": "DENY" },
                { "key": "X-Content-Type-Options", "value": "nosniff" },
                { "key": "Referrer-Policy", "value": "no-referrer-when-cross-origin" },
                {
                    "key": "Strict-Transport-Security",
                    "value": "max-age=31536000; includeSubDomains; preload"
                }
            ]
        }
    ],
    "rewrites": [
        {
            "source": "/api/twitch/",
            "destination": "/index.html"
        },
        {
            "source": "/api/twitch/docs",
            "destination": "/docs/index.html"
        },
        {
            "source": "/api/twitch/docs/",
            "destination": "/docs/index.html"
        },
        {
            "source": "/api/twitch/dashboard",
            "destination": "/dashboard/index.html"
        },
        {
            "source": "/api/twitch/dashboard/",
            "destination": "/dashboard/index.html"
        },
        {
            "source": "/api/twitch/sobre-la-api",
            "destination": "/sobre-la-api/index.html"
        },
        {
            "source": "/api/twitch/sobre-la-api/",
            "destination": "/sobre-la-api/index.html"
        },
        {
            "source": "/api/twitch/privacidad",
            "destination": "/privacidad/index.html"
        },
        {
            "source": "/api/twitch/privacidad/",
            "destination": "/privacidad/index.html"
        },
        {
            "source": "/api/twitch/terminos",
            "destination": "/terminos/index.html"
        },
        {
            "source": "/api/twitch/terminos/",
            "destination": "/terminos/index.html"
        },
        {
            "source": "/api/twitch/cookies",
            "destination": "/cookies/index.html"
        },
        {
            "source": "/api/twitch/cookies/",
            "destination": "/cookies/index.html"
        },
        {
            "source": "/api/twitch/offline",
            "destination": "/offline/index.html"
        },
        {
            "source": "/api/twitch/offline/",
            "destination": "/offline/index.html"
        },
        {
            "source": "/api/twitch/404",
            "destination": "/404.html"
        },
        {
            "source": "/api/twitch/404/",
            "destination": "/404.html"
        },
        {
            "source": "/api/twitch/429",
            "destination": "/429/index.html"
        },
        {
            "source": "/api/twitch/429/",
            "destination": "/429/index.html"
        },
        {
            "source": "/api/twitch/500",
            "destination": "/500.html"
        },
        {
            "source": "/api/twitch/500/",
            "destination": "/500.html"
        },
        {
            "source": "/api/twitch/_astro/:path*",
            "destination": "/_astro/:path*"
        },
        {
            "source": "/api/twitch/_vercel/:path*",
            "destination": "/_vercel/:path*"
        },
        {
            "source": "/api/twitch/img/:path*",
            "destination": "/img/:path*"
        },
        {
            "source": "/api/twitch/sw.js",
            "destination": "/sw.js"
        },
        {
            "source": "/api/twitch/manifest.json",
            "destination": "/manifest.json"
        },
        {
            "source": "/api/twitch/create-clip",
            "destination": "/api/index.js"
        },
        {
            "source": "/api/twitch/followage",
            "destination": "/api/index.js"
        },
        {
            "source": "/api/twitch/shoutout",
            "destination": "/api/index.js"
        },
        {
            "source": "/api/twitch/send-message",
            "destination": "/api/index.js"
        },
        {
            "source": "/api/twitch/health",
            "destination": "/api/index.js"
        },
        {
            "source": "/api/twitch/minigames/:path*",
            "destination": "/api/index.js"
        },
        {
            "source": "/api/twitch/dashboard/:endpoint(get-clips|analytics|chatters|user-info|summary|activity|track-usage|timezone|clear-data|delete-account|export-check)",
            "destination": "/api/index.js"
        },
        {
            "source": "/api/twitch/system/:path*",
            "destination": "/api/index.js"
        },
        {
            "source": "/api/twitch/auth/:path*",
            "destination": "/api/index.js"
        },
        {
            "source": "/twitch/:path*",
            "destination": "/api/index.js"
        },
        {
            "source": "/auth/:path*",
            "destination": "/api/index.js"
        },
        {
            "source": "/health",
            "destination": "/api/index.js"
        },
        {
            "source": "/robots.txt",
            "destination": "/api/index.js"
        },
        {
            "source": "/sitemap.xml",
            "destination": "/api/index.js"
        }
    ]
}
