{
    "version": 2,
    "builds": [
        {
            "src": "server.js",
            "use": "@vercel/node"
        }
    ],
    "rewrites": [
        {
            "source": "/auth/(.*)",
            "destination": "/server.js"
        },
        {
            "source": "/api/(.*)",
            "destination": "/server.js"
        }
    ]
}